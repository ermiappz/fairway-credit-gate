{
  "name": "fairway-credit-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Private member credit for savings cooperatives on Midnight: SACCO-signed profile, member-side ZK proof, outcome-only ledger.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/sacco-credit-gate.compact contract/managed/sacco-credit-gate",
    "compile:fast": "compact compile --skip-zk contract/sacco-credit-gate.compact contract/managed/sacco-credit-gate",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "demo": "tsx demo/demo.ts",
    "attestation:start": "tsx attestation-api/index.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "restify": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/restify": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1"
  }
}
