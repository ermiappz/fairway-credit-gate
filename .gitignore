# The --skip-zk compiler output (contract/managed/**) is committed so the
# tests run with only Node installed; CI recompiles it and fails on drift.
# Proving/verifying keys from a full `compact compile` are large and
# reproducible, so they stay out of git.
contract/managed/*/keys/
contract/managed/*/zkir/*.bzkir

